{
  "name": "@sapiencia-web/web",
  "private": true,
  "version": "0.1.0",
  "description": "Front-end de Sapiencia (React + Vite): inicio, /principal (HTML puro), /sivu (SIVU: edificio en 3D y tableros), /odes, /repositorio, /tableros, /pai y /pertinencia.",
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0"
  },
  "scripts": {
    "copiar-draco": "node scripts/copiar-draco.mjs",
    "postinstall": "node scripts/copiar-draco.mjs",
    "predev": "node scripts/copiar-draco.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copiar-draco.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings"
  },
  "dependencies": {
    "echarts": "5.6.0",
    "katex": "0.16.47",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "~0.180.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "oxlint": "^1.87.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}

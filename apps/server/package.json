{
  "name": "@sapiencia-web/server",
  "version": "0.1.0",
  "description": "Servidor NestJS de sapiencia-web: API en /api y front-end compilado para /principal, /sivu, /odes, /repositorio, /tableros, /pai y /pertinencia.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --deny-warnings src/ test/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "odes:indexar": "nest build && node dist/odes/cli/indexar.js",
    "odes:evaluar-busqueda": "nest build && node dist/odes/cli/evaluar-busqueda.js",
    "odes:probar": "nest build && node dist/odes/cli/probar-chat.js",
    "repositorio:migrar": "nest build && node dist/repositorio/cli/migrar.js",
    "repositorio:importar": "nest build && node dist/repositorio/cli/importar.js",
    "repositorio:crear-admin": "nest build && node dist/repositorio/cli/crear-admin.js",
    "repositorio:revision": "nest build && node dist/repositorio/cli/revision.js",
    "tableros:cargar-matricula": "nest build && node dist/sivu/tableros/cargar-matricula.js",
    "tableros:cargar-fondos": "nest build && node dist/sivu/tableros/cargar-fondos.js",
    "tableros:crear-usuario": "nest build && node dist/sivu/acceso/crear-usuario-tableros.js",
    "pai:crear-usuario": "nest build && node dist/pai/cli/crear-usuario.js",
    "pai:cargar-fichas": "nest build && node dist/pai/cli/cargar-fichas.js",
    "pai:recolectar-evidencias": "nest build && node dist/pai/cli/recolectar-evidencias.js",
    "crm:clave-lider": "nest build && node dist/crm/cli/clave-lider.js",
    "crm:cargar-equipo": "nest build && node dist/crm/cli/cargar-equipo.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
